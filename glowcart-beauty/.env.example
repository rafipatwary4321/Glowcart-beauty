# GlowCart Beauty — environment variables

# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Never commit .env.local or real secrets to git.

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── MongoDB (required) ───────────────────────────────────────────────────────
MONGODB_URI=

# ── Auth.js / NextAuth (required in production) ──────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin seed (npm run seed — change after first deploy) ────────────────────
ADMIN_EMAIL=admin@glowcart.com
ADMIN_PASSWORD=change-me-in-production
ADMIN_SEED_EMAIL=admin@glowcart.com
ADMIN_SEED_PASSWORD=change-me-in-production
ADMIN_SEED_NAME=GlowCart Admin

# ── Cloudinary (recommended for image uploads) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── SSLCommerz (online payments) ─────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# ── bKash (optional — stub ready) ────────────────────────────────────────────
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# ── Nagad (optional — stub ready) ────────────────────────────────────────────
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=

# ── Email / SMTP (recommended) ───────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GlowCart Beauty <noreply@glowcart.com>"

# ── Playwright E2E (optional — local/CI testing) ─────────────────────────────
PLAYWRIGHT_BASE_URL=http://localhost:3000
E2E_ADMIN_EMAIL=admin@glowcart.com
E2E_ADMIN_PASSWORD=change-me-in-production
E2E_CUSTOMER_EMAIL=demo@glowcart.com
E2E_CUSTOMER_PASSWORD=demo1234
